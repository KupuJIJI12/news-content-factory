{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=newsfactory;Username=postgres;Password=postgres"
  },
  "App": {
    "TimeZone": "Europe/Samara"
  },
  "Hangfire": {
    "WorkerCount": 4
  },
  "Images": {
    "Root": "data/images"
  },
  "Llm": {
    "Throttle": {
      "MinIntervalMs": 2000,
      "RateLimitBackoffSeconds": [ 15, 60 ],
      "PostponeMinutes": 10
    }
  },
  "AllowedHosts": "*"
}
